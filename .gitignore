# ============================================================================
# Anchor .gitignore
# ============================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
*.pem
backend/data/ssl/

# Node / Frontend
node_modules/
dist/
.vite/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
backend/tests/__pycache__/
backend/.pytest_cache/
anchor_face/

# SQLite & Data files
*.db
*.db-wal
*.db-shm
data/*.db
data/*.db-wal
data/*.db-shm
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.jsonl
backend/data/face_profiles.json

# IDE & OS
.DS_Store
.idea/
.vscode/
Remindly/
*.log