# ============================================================================
# Anchor — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# ============================================================================

# 1. Supabase / PostgreSQL Database Connection (pgvector enabled)
DATABASE_URL="postgresql://postgres.your_project_id:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 2. Groq Cloud API Key (for LLM Summarization & Whisper STT)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# 3. OpenAI API Key (Optional fallback for Whisper / GPT-4o)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"

# 4. HuggingFace Token (Optional: for local pyannote speaker diarization)
# HF_TOKEN="hf_your_huggingface_token_here"
